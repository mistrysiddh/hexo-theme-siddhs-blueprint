<%
  var variant = typeof variant !== 'undefined' ? variant : 'latest';
  var cats = post.categories ? post.categories.toArray() : [];
  var cat = cats.length ? cats[0] : null;
  var mod = cat ? category_module(cat.slug) : null;
  var tags = post.tags ? post.tags.toArray() : [];
  var words = word_count(post.content);
  var chars = char_count(post.content);
  var views = pseudo_stat(post.slug + '-views', 800, 42000);
  var likes = pseudo_stat(post.slug + '-likes', 20, 900);
%>
<article class="bp-panel group flex h-full flex-col">
  <span class="bp-corner tl"></span><span class="bp-corner tr"></span><span class="bp-corner bl"></span><span class="bp-corner br"></span>

  <a href="<%- url_for(post.path) %>" class="relative block aspect-[16/10] overflow-hidden border-b border-cyan/15">
    <img src="<%= post.cover %>" alt="<%= post.title %>" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105">
    <div class="absolute inset-0 bg-gradient-to-t from-navy-900/70 via-transparent to-transparent"></div>
    <span class="absolute top-2 left-2 font-mono text-[9px] text-cyan-bright bg-navy-900/70 border border-cyan/30 px-1.5 py-0.5"><%= drawing_number(post.slug) %></span>
    <% if (mod) { %>
    <span class="absolute bottom-2 left-2 inline-flex items-center gap-1 border px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-cyan border-cyan/40 bg-navy-900/70">
      <%= mod.code %> · <%= cat.name %>
    </span>
    <% } %>
  </a>

  <div class="flex flex-1 flex-col p-4">
    <a href="<%- url_for(post.path) %>">
      <h3 class="font-display text-base md:text-lg font-semibold text-white leading-snug group-hover:text-cyan-bright transition-colors"><%= post.title %></h3>
    </a>
    <p class="mt-2 text-sm text-steel leading-relaxed line-clamp-2"><%= post.description || excerpt_text(post.content, 140) %></p>

    <div class="mt-4 flex items-center gap-2 text-xs text-steel-dim">
      <img src="<%= theme.author.avatar %>" alt="<%= theme.author.name %>" class="h-5 w-5 rounded-full border border-cyan/30">
      <span class="text-steel-bright"><%= post.author || theme.author.name %></span>
      <span>·</span>
      <span><%= date(post.date, 'MMM DD, YYYY') %></span>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1.5 border-t border-cyan/10 pt-3 font-mono text-[10px] text-steel-dim">
      <span class="flex items-center gap-1"><%- icon('clock', 11) %> <%= reading_time(post.content) %> MIN</span>
      <span class="flex items-center gap-1"><%- icon('eye', 11) %> <%= views.toLocaleString() %></span>
      <span class="flex items-center gap-1"><%- icon('heart', 11) %> <%= likes.toLocaleString() %></span>
      <% if (variant === 'latest') { %>
      <span class="flex items-center gap-1"><%- icon('list', 11) %> <%= words %>w</span>
      <span class="flex items-center gap-1"><%- icon('hash', 11) %> <%= chars %>ch</span>
      <% } %>
    </div>

    <% if (variant === 'latest' && tags.length) { %>
    <div class="mt-3 flex flex-wrap gap-1.5">
      <% tags.slice(0, 3).forEach(function (t) { %>
      <span class="border border-cyan/15 px-1.5 py-0.5 font-mono text-[9px] text-cyan-dim">#<%= t.name %></span>
      <% }) %>
    </div>
    <% } %>

    <a href="<%- url_for(post.path) %>" class="mt-4 inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider text-cyan hover:gap-2.5 transition-all">
      Continue Reading <%- icon('arrow-up-right', 13) %>
    </a>
  </div>
</article>
