<%
  var current = typeof current !== 'undefined' ? current : 1;
  var total = typeof total !== 'undefined' ? total : 1;
  var base = typeof base !== 'undefined' ? base : '/';
  function pageHref(p) {
    return p <= 1 ? base : base.replace(/\/$/, '') + '/page/' + p + '/';
  }
%>
<% if (total > 1) { %>
<nav aria-label="Pagination" class="flex items-center justify-center gap-1.5 font-mono text-xs">
  <a href="<%- url_for(pageHref(Math.max(1, current - 1))) %>" class="flex h-9 w-9 items-center justify-center border border-cyan/25 text-steel hover:border-cyan hover:text-cyan transition-colors <%= current === 1 ? 'pointer-events-none opacity-30' : '' %>">
    <%- icon('chevron-left', 14) %>
  </a>
  <% for (var p = 1; p <= total; p++) { %>
  <a href="<%- url_for(pageHref(p)) %>" class="flex h-9 w-9 items-center justify-center border transition-colors <%= p === current ? 'border-cyan bg-cyan/10 text-cyan' : 'border-cyan/20 text-steel hover:border-cyan hover:text-cyan' %>">
    <%= String(p).padStart(2, '0') %>
  </a>
  <% } %>
  <a href="<%- url_for(pageHref(Math.min(total, current + 1))) %>" class="flex h-9 w-9 items-center justify-center border border-cyan/25 text-steel hover:border-cyan hover:text-cyan transition-colors <%= current === total ? 'pointer-events-none opacity-30' : '' %>">
    <%- icon('chevron-right', 14) %>
  </a>
</nav>
<% } %>
