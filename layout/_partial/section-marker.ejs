<%
  var align = typeof align !== 'undefined' ? align : 'left';
%>
<div class="mb-10 <%= align === 'center' ? 'text-center' : '' %>">
  <div class="flex items-center gap-3 mb-3 <%= align === 'center' ? 'justify-center' : '' %>">
    <span class="font-mono text-xs text-cyan border border-cyan/40 px-2 py-0.5">§ <%= index %></span>
    <span class="bp-dashed flex-1 max-w-[80px]"></span>
    <span class="bp-label">SECTION</span>
  </div>
  <h2 class="font-display text-2xl md:text-4xl font-semibold text-white tracking-tight"><%= title %></h2>
  <% if (typeof description !== 'undefined' && description) { %>
  <p class="mt-2 text-steel max-w-2xl text-sm md:text-base leading-relaxed"><%= description %></p>
  <% } %>
</div>
