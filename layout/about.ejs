<%
  var recentPosts = site.posts.sort('-date').limit(3).toArray();
  var socialLinks = [
    { key: 'github', label: 'GitHub' },
    { key: 'linkedin', label: 'LinkedIn' },
    { key: 'twitter', label: 'Twitter' },
    { key: 'instagram', label: 'Instagram' },
    { key: 'youtube', label: 'YouTube' },
  ];
%>
<div class="mx-auto max-w-6xl px-4 md:px-6 py-10">
  <%- partial('_partial/breadcrumbs', { crumbs: [{ label: 'About' }] }) %>

  <div class="mt-6 bp-panel bg-navy-700/30 p-6 md:p-10">
    <span class="bp-corner tl !w-5 !h-5"></span><span class="bp-corner tr !w-5 !h-5"></span>
    <span class="bp-corner bl !w-5 !h-5"></span><span class="bp-corner br !w-5 !h-5"></span>
    <div class="flex flex-col items-center gap-6 text-center md:flex-row md:text-left">
      <div class="relative h-28 w-28 flex-shrink-0 border-2 border-cyan/40 md:h-36 md:w-36 overflow-hidden">
        <img src="<%= theme.author.avatar %>" alt="<%= theme.author.name %>" class="h-full w-full object-cover">
      </div>
      <div>
        <span class="bp-label">OPERATOR PROFILE — BPL-AUTHOR-001</span>
        <h1 class="mt-1 font-display text-2xl md:text-4xl font-semibold text-white"><%= theme.author.name %></h1>
        <p class="text-cyan text-sm md:text-base mt-1"><%= theme.author.role %></p>
        <p class="mt-3 max-w-2xl text-sm text-steel leading-relaxed"><%= theme.author.bio %></p>

        <div class="mt-5 flex flex-wrap items-center justify-center gap-2 md:justify-start">
          <% socialLinks.forEach(function (s) { %>
          <a href="<%= theme.social[s.key] %>" aria-label="<%= s.label %>" class="flex h-9 w-9 items-center justify-center border border-cyan/25 text-steel hover:border-cyan hover:text-cyan transition-colors"><%- icon(s.key, 15) %></a>
          <% }) %>
          <a href="<%= theme.author.email %>" aria-label="Email" class="flex h-9 w-9 items-center justify-center border border-cyan/25 text-steel hover:border-cyan hover:text-cyan transition-colors"><%- icon('mail', 15) %></a>
          <a href="<%- url_for(theme.author.resume) %>" download class="ml-1 flex items-center gap-2 border border-cyan/40 bg-cyan/10 px-3 py-2 font-mono text-xs uppercase tracking-wider text-cyan hover:bg-cyan hover:text-navy-900 transition-colors"><%- icon('download', 13) %> Resume</a>
          <a href="<%= theme.author.email %>" class="flex items-center gap-2 border border-cyan px-3 py-2 font-mono text-xs uppercase tracking-wider text-navy-900 bg-cyan hover:bg-cyan-bright transition-colors"><%- icon('message-circle', 13) %> Contact</a>
        </div>
      </div>
    </div>
  </div>

  <section class="mt-16">
    <%- partial('_partial/section-marker', { index: '02', title: 'Experience' }) %>
    <div class="space-y-4">
      <% theme.experience.forEach(function (e) { %>
      <div class="bp-panel p-5">
        <span class="bp-corner tl"></span><span class="bp-corner br"></span>
        <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-2">
            <%- icon('briefcase', 15) %>
            <h3 class="font-display text-base font-semibold text-white"><%= e.role %></h3>
            <span class="text-steel-dim text-sm">— <%= e.org %></span>
          </div>
          <span class="font-mono text-[11px] text-cyan-dim"><%= e.period %></span>
        </div>
        <p class="mt-2 text-sm text-steel leading-relaxed"><%= e.description %></p>
      </div>
      <% }) %>
    </div>
  </section>

  <section class="mt-16">
    <%- partial('_partial/section-marker', { index: '03', title: 'Skills Matrix' }) %>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% theme.skills.forEach(function (s) { %>
      <div class="bp-panel p-4">
        <span class="bp-corner tl"></span><span class="bp-corner br"></span>
        <p class="bp-label mb-3"><%= s.group %></p>
        <div class="flex flex-wrap gap-1.5">
          <% s.items.forEach(function (item) { %>
          <span class="border border-cyan/20 px-2 py-1 font-mono text-[11px] text-steel-bright"><%= item %></span>
          <% }) %>
        </div>
      </div>
      <% }) %>
    </div>
  </section>

  <div class="mt-16 grid grid-cols-1 gap-16 lg:grid-cols-2">
    <section>
      <%- partial('_partial/section-marker', { index: '04', title: 'Education' }) %>
      <div class="space-y-3">
        <% theme.education.forEach(function (ed) { %>
        <div class="bp-panel p-4">
          <span class="bp-corner tl"></span><span class="bp-corner br"></span>
          <div class="flex items-center gap-2"><%- icon('graduation-cap', 15) %><h3 class="font-display text-sm font-semibold text-white"><%= ed.degree %></h3></div>
          <p class="mt-1 text-xs text-steel-dim"><%= ed.school %> · <%= ed.period %></p>
        </div>
        <% }) %>
      </div>
    </section>

    <section>
      <%- partial('_partial/section-marker', { index: '05', title: 'Certifications' }) %>
      <div class="space-y-3">
        <% theme.certifications.forEach(function (c) { %>
        <div class="bp-panel flex items-center justify-between p-4">
          <span class="bp-corner tl"></span><span class="bp-corner br"></span>
          <span class="flex items-center gap-2 text-sm text-steel-bright"><%- icon('badge-check', 15) %> <%= c.name %></span>
          <span class="font-mono text-[11px] text-cyan-dim flex-shrink-0"><%= c.year %></span>
        </div>
        <% }) %>
      </div>
    </section>
  </div>

  <section class="mt-16">
    <%- partial('_partial/section-marker', { index: '06', title: 'Achievements' }) %>
    <div class="bp-panel p-5">
      <span class="bp-corner tl"></span><span class="bp-corner br"></span>
      <ul class="space-y-3">
        <% theme.achievements.forEach(function (a) { %>
        <li class="flex items-start gap-3 text-sm text-steel-bright/90 leading-relaxed"><%- icon('award', 15) %> <%= a %></li>
        <% }) %>
      </ul>
    </div>
  </section>

  <section class="mt-16">
    <%- partial('_partial/section-marker', { index: '07', title: 'Projects' }) %>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <% theme.projects.forEach(function (p) { %>
      <a href="<%= p.url %>" class="group">
        <div class="bp-panel p-4 h-full group-hover:border-cyan/60 transition-colors">
          <span class="bp-corner tl"></span><span class="bp-corner br"></span>
          <div class="flex items-center gap-2 mb-2"><%- icon('folder-git-2', 15) %><h3 class="font-mono text-sm text-white"><%= p.name %></h3></div>
          <p class="text-xs text-steel leading-relaxed"><%= p.description %></p>
        </div>
      </a>
      <% }) %>
    </div>
  </section>

  <section class="mt-16">
    <%- partial('_partial/section-marker', { index: '08', title: 'Favorite Technologies' }) %>
    <div class="flex flex-wrap gap-2">
      <% theme.favorite_tech.forEach(function (t) { %>
      <span class="flex items-center gap-1.5 border border-cyan/25 px-3 py-1.5 font-mono text-xs text-steel-bright"><%- icon('heart', 11) %> <%= t %></span>
      <% }) %>
    </div>
  </section>

  <section class="mt-16 mb-4">
    <%- partial('_partial/section-marker', { index: '09', title: 'Recent Articles', description: 'Latest documents authored.' }) %>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% recentPosts.forEach(function (post) { %>
      <%- partial('_partial/article-card', { post: post, variant: 'featured' }) %>
      <% }) %>
    </div>
  </section>
</div>
