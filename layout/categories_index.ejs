<%
  var moduleSlugs = Object.keys(theme.category_modules);
  var allPosts = site.posts.sort('-date').toArray();
  var allTags = site.tags.sort('name').toArray();
  var totalDocs = allPosts.length;

  function postsFor(slug) {
    return allPosts.filter(function (p) {
      return p.categories.toArray().some(function (c) { return c.slug === slug; });
    });
  }
%>
<div class="mx-auto max-w-7xl px-4 md:px-6 py-10">
  <%- partial('_partial/breadcrumbs', { crumbs: [{ label: 'Categories' }] }) %>
  <div class="mt-4">
    <%- partial('_partial/section-marker', {
      index: '01',
      title: 'System Modules Index',
      description: 'Every discipline documented on this site, organized as an engineering module. ' + totalDocs + ' documents indexed across ' + moduleSlugs.length + ' modules.'
    }) %>
  </div>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-8">
    <div class="relative flex-1 max-w-sm">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-cyan-dim"><%- icon('search', 14) %></span>
      <input id="bp-categories-filter" type="text" placeholder="Filter modules..." class="w-full border border-cyan/25 bg-navy-700/50 py-2 pl-9 pr-3 font-mono text-xs text-white placeholder:text-steel-dim outline-none focus:border-cyan">
    </div>
    <select id="bp-categories-sort" class="border border-cyan/25 bg-navy-700/50 px-3 py-2 font-mono text-xs text-white">
      <option value="posts-desc">SORT: MOST DOCUMENTS</option>
      <option value="posts-asc">SORT: FEWEST DOCUMENTS</option>
      <option value="az">SORT: A → Z</option>
    </select>
  </div>

  <div id="bp-categories-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <% moduleSlugs.forEach(function (slug) {
         var mod = theme.category_modules[slug];
         var posts = postsFor(slug);
         var latest = posts[0];
         var label = mod.label;
    %>
    <a
      href="<%- url_for('/categories/' + slug + '/') %>"
      class="group relative border border-cyan/15 bg-navy-700/30 p-5 hover:border-cyan/60 hover:bg-cyan/5 transition-colors"
      data-category-card
      data-name="<%= (mod.name + ' ' + label + ' ' + mod.description).toLowerCase() %>"
      data-count="<%= posts.length %>"
      data-label="<%= label.toLowerCase() %>"
    >
      <span class="bp-corner tl"></span><span class="bp-corner tr"></span><span class="bp-corner bl"></span><span class="bp-corner br"></span>
      <div class="flex items-start justify-between">
        <span class="flex h-11 w-11 items-center justify-center border border-cyan/30 text-cyan group-hover:bg-cyan/10 transition-colors"><%- icon(mod.icon, 20) %></span>
        <span class="font-mono text-[10px] text-cyan-dim"><%= mod.code %></span>
      </div>
      <h3 class="mt-4 font-display text-lg font-semibold text-white group-hover:text-cyan-bright transition-colors"><%= mod.name %></h3>
      <p class="text-xs text-steel-dim mb-2"><%= label %></p>
      <p class="text-sm text-steel leading-relaxed line-clamp-2"><%= mod.description %></p>
      <div class="mt-4 border-t border-cyan/10 pt-3 font-mono text-[10px] text-steel-dim">
        <%= posts.length %> DOC<%= posts.length !== 1 ? 'S' : '' %> INDEXED
        <% if (latest) { %><p class="mt-1 truncate text-steel-bright normal-case">Latest: <%= latest.title %></p><% } %>
      </div>
    </a>
    <% }) %>
  </div>
  <p id="bp-categories-empty" class="hidden text-center font-mono text-xs text-steel-dim py-16">No modules match that filter.</p>

  <% if (allTags.length) { %>
  <div class="mt-14 border-t border-cyan/15 pt-8">
    <p class="bp-label mb-4">Browse By Tag</p>
    <div class="flex flex-wrap gap-2">
      <% allTags.forEach(function (t) { %>
      <a href="<%- url_for('/tags/' + t.slug + '/') %>" class="inline-flex items-center gap-1 rounded-full border border-cyan/25 px-2.5 py-1 font-mono text-[10px] text-steel-bright hover:border-cyan hover:text-cyan transition-colors">
        <%- icon('hash', 9) %><%= t.name %>
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>
</div>
