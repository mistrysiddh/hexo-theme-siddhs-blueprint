<%
  var allPosts = site.posts.sort('-date').toArray();
  var featured = allPosts.filter(function (p) { return p.featured; });
  var heroPosts = featured.slice(0, 5);
  var editorsPosts = featured.slice(0, 4);
  var latestPosts = allPosts.slice(0, 6);
  var moduleSlugs = Object.keys(theme.category_modules);

  function postSummary(p) {
    var cats = p.categories ? p.categories.toArray() : [];
    var cat = cats.length ? cats[0] : null;
    var mod = cat ? category_module(cat.slug) : null;
    return {
      title: p.title,
      description: p.description || excerpt_text(p.content, 160),
      cover: p.cover,
      path: url_for(p.path),
      author: p.author || theme.author.name,
      authorAvatar: theme.author.avatar,
      date: p.date.toISOString(),
      dateDisplay: date(p.date, 'MMMM DD, YYYY'),
      dateShort: date(p.date, 'MMM DD, YYYY'),
      readingTime: reading_time(p.content),
      categoryName: cat ? cat.name : '',
      moduleCode: mod ? mod.code : '',
      drawingNumber: drawing_number(p.slug),
      revisionCode: revision_code(p.date),
    };
  }
%>
<section id="bp-hero" data-widget="HeroSlider" data-widget-props='<%- widget_props({ posts: heroPosts.map(postSummary), autoplayMs: theme.appearance.hero_autoplay_ms }) %>'>
  <% if (heroPosts.length) { var hp = postSummary(heroPosts[0]); %>
  <div class="relative border-b border-cyan/20 overflow-hidden">
    <div class="absolute inset-0 bg-blueprint-grid-major bg-grid-major opacity-40" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 md:px-6 pt-8 pb-4">
      <div class="flex items-center justify-between font-mono text-[10px] text-cyan-dim uppercase tracking-wider mb-3">
        <span>DWG. COVER SHEET — FEATURED PUBLICATIONS</span>
        <span><%= hp.drawingNumber %> / <%= hp.revisionCode %></span>
      </div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 md:px-6 pb-10">
      <div class="bp-panel bg-navy-700/40">
        <span class="bp-corner tl !w-5 !h-5"></span><span class="bp-corner tr !w-5 !h-5"></span>
        <span class="bp-corner bl !w-5 !h-5"></span><span class="bp-corner br !w-5 !h-5"></span>
        <div class="grid grid-cols-1 lg:grid-cols-2">
          <div class="relative aspect-[16/10] lg:aspect-auto overflow-hidden border-b lg:border-b-0 lg:border-r border-cyan/20">
            <img src="<%= hp.cover %>" alt="<%= hp.title %>" class="absolute inset-0 h-full w-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900/80 via-navy-900/10 to-transparent"></div>
            <span class="absolute bottom-3 right-3 font-mono text-[9px] text-steel-bright bg-navy-900/60 px-1.5 py-0.5 border border-cyan/20">SCALE 1:1 · <%= hp.dateShort %></span>
          </div>
          <div class="flex flex-col justify-center p-6 md:p-10">
            <span class="mb-4 inline-flex w-fit items-center gap-2 border border-cyan/40 px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-cyan"><%= hp.moduleCode %> · <%= hp.categoryName %></span>
            <h1 class="font-display text-2xl md:text-4xl font-semibold text-white leading-tight"><%= hp.title %></h1>
            <p class="mt-3 text-sm md:text-base text-steel leading-relaxed line-clamp-3"><%= hp.description %></p>
            <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs text-steel-dim">
              <span class="flex items-center gap-1.5"><img src="<%= hp.authorAvatar %>" class="h-[18px] w-[18px] rounded-full border border-cyan/30"> <%= hp.author %></span>
              <span class="flex items-center gap-1.5"><%- icon('calendar', 12) %> <%= hp.dateDisplay %></span>
              <span class="flex items-center gap-1.5"><%- icon('clock', 12) %> <%= hp.readingTime %> MIN READ</span>
            </div>
            <a href="<%= hp.path %>" class="mt-7 inline-flex w-fit items-center gap-2 border border-cyan bg-cyan/10 px-5 py-2.5 font-mono text-xs uppercase tracking-wider text-cyan hover:bg-cyan hover:text-navy-900 transition-colors">Open Document →</a>
          </div>
        </div>
      </div>
      <p class="mt-4 text-center font-mono text-[10px] text-steel-dim">Loading interactive cover sheet…</p>
    </div>
  </div>
  <% } %>
</section>

<section class="mx-auto max-w-7xl px-4 md:px-6 py-16 md:py-20">
  <%- partial('_partial/section-marker', { index: '02', title: "Editor's Selection", description: 'Hand-picked technical documents, reviewed and approved for publication.' }) %>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
    <% editorsPosts.forEach(function (post) { %>
    <%- partial('_partial/article-card', { post: post, variant: 'featured' }) %>
    <% }) %>
  </div>
</section>

<section class="border-y border-cyan/15 bg-navy-600/30">
  <div class="mx-auto max-w-7xl px-4 md:px-6 py-16 md:py-20">
    <%- partial('_partial/section-marker', { index: '03', title: 'System Modules', description: 'Every category is a module in the larger system — browse by discipline.' }) %>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      <% moduleSlugs.forEach(function (slug) {
           var mod = theme.category_modules[slug];
           var count = allPosts.filter(function (p) {
             return p.categories.toArray().some(function (c) { return c.slug === slug; });
           }).length;
           var hasPosts = count > 0;
           var Tag = hasPosts ? 'a' : 'div';
      %>
      <<%= Tag %> <% if (hasPosts) { %>href="<%- url_for('/categories/' + slug + '/') %>"<% } %> class="group relative flex flex-col items-start border border-cyan/15 bg-navy-700/30 p-4 transition-colors <%= hasPosts ? 'hover:border-cyan/60 hover:bg-cyan/5' : 'opacity-50' %>">
        <span class="bp-corner tl"></span><span class="bp-corner br"></span>
        <div class="flex w-full items-center justify-between">
          <span class="flex h-10 w-10 items-center justify-center border border-cyan/30 text-cyan <%= hasPosts ? 'group-hover:bg-cyan/10' : '' %> transition-colors"><%- icon(mod.icon, 18) %></span>
          <span class="font-mono text-[10px] text-cyan-dim"><%= mod.code %></span>
        </div>
        <h3 class="mt-3 font-display text-sm font-semibold text-white <%= hasPosts ? 'group-hover:text-cyan-bright' : '' %> transition-colors"><%= mod.name %></h3>
        <p class="text-[11px] text-steel-dim"><%= mod.label %></p>
        <span class="mt-3 font-mono text-[10px] text-steel-dim border-t border-cyan/10 pt-2 w-full"><%= hasPosts ? (count + ' DOC' + (count !== 1 ? 'S' : '') + ' INDEXED') : 'NO DOCUMENTS YET' %></span>
      </<%= Tag %>>
      <% }) %>
    </div>
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 md:px-6 py-16 md:py-20">
  <%- partial('_partial/section-marker', { index: '04', title: 'Latest Articles', description: 'Full documentation log, most recent revisions first.' }) %>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <% latestPosts.forEach(function (post) { %>
    <%- partial('_partial/article-card', { post: post, variant: 'latest' }) %>
    <% }) %>
  </div>
  <div class="mt-10 flex justify-center">
    <a href="<%- url_for('/categories/') %>" class="inline-flex items-center justify-center gap-2 border font-mono uppercase tracking-wider px-5 py-2.5 text-xs bg-transparent text-cyan border-cyan/40 hover:border-cyan hover:bg-cyan/10 transition-colors">
      Browse Full Archive <%- icon('arrow-right', 13) %>
    </a>
  </div>
</section>

<section class="mx-auto max-w-5xl px-4 md:px-6 pb-20">
  <div class="bp-panel relative overflow-hidden bg-navy-700/40 px-6 py-12 md:px-14 text-center">
    <span class="bp-corner tl !w-5 !h-5"></span><span class="bp-corner tr !w-5 !h-5"></span>
    <span class="bp-corner bl !w-5 !h-5"></span><span class="bp-corner br !w-5 !h-5"></span>
    <div class="absolute inset-0 bg-blueprint-grid bg-grid opacity-30" aria-hidden="true"></div>
    <div class="relative">
      <span class="mx-auto mb-4 flex h-12 w-12 items-center justify-center border border-cyan/40 text-cyan"><%- icon('radio', 22) %></span>
      <p class="bp-label mb-2">TRANSMISSION MODULE</p>
      <h2 class="font-display text-2xl md:text-3xl font-semibold text-white">Subscribe to Revision Updates</h2>
      <p class="mx-auto mt-3 max-w-md text-sm text-steel leading-relaxed">New specifications, deep dives, and field notes — delivered when a new document is published. No noise.</p>
      <div class="mx-auto mt-6 max-w-sm" data-widget="Newsletter" data-widget-props='<%- widget_props({ compact: false, provider: theme.newsletter.provider, listmonk: theme.newsletter.listmonk }) %>'>
        <p class="text-xs text-steel-dim font-mono">Loading subscription module…</p>
      </div>
    </div>
  </div>
</section>
