<%
  var cats = page.categories ? page.categories.toArray() : [];
  var cat = cats.length ? cats[0] : null;
  var mod = cat ? category_module(cat.slug) : null;
  var tags = page.tags ? page.tags.toArray() : [];
  var words = word_count(page.content);
  var chars = char_count(page.content);

  var blueprintFields = [
    { label: 'Designer', value: page.author || theme.author.name },
    { label: 'Module', value: mod ? (mod.code + ' — ' + cat.name) : (cat ? cat.name : '—') },
    { label: 'Runtime', value: reading_time(page.content) + ' min read' },
    { label: 'Documentation Length', value: words + ' words / ' + chars + ' chars' },
    { label: 'Revision', value: revision_code(page.updated || page.date) },
    { label: 'Version Released', value: page.version || 'v1.0' },
  ];

  var relatedPosts = cat
    ? site.posts.sort('-date').filter(function (p) {
        if (p.slug === page.slug) return false;
        var pcats = p.categories.toArray();
        return pcats.some(function (c) { return c.slug === cat.slug; });
      }).slice(0, 3)
    : [];
%>
<article>
  <header class="border-b border-cyan/15">
    <div class="relative aspect-[21/9] w-full overflow-hidden border-b border-cyan/15">
      <img src="<%= page.cover %>" alt="<%= page.title %>" class="absolute inset-0 h-full w-full object-cover">
      <div class="absolute inset-0 bg-gradient-to-t from-navy-900 via-navy-900/40 to-navy-900/10"></div>
      <div class="absolute inset-0 bg-blueprint-grid-major bg-grid-major opacity-20"></div>
      <div class="absolute top-4 left-4 font-mono text-[10px] text-cyan-bright bg-navy-900/60 border border-cyan/30 px-2 py-1"><%= drawing_number(page.slug) %></div>
      <div class="absolute bottom-0 left-0 right-0 mx-auto max-w-5xl px-4 md:px-6 pb-8">
        <% if (mod) { %>
        <span class="mb-4 inline-flex items-center gap-1 border px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-cyan border-cyan/40 bg-navy-900/60"><%= mod.code %> · <%= cat.name %></span>
        <% } %>
        <h1 class="font-display text-3xl md:text-5xl font-semibold text-white leading-tight max-w-3xl"><%= page.title %></h1>
        <% if (page.subtitle) { %>
        <p class="mt-3 text-base md:text-lg text-steel-bright max-w-2xl"><%= page.subtitle %></p>
        <% } %>
      </div>
    </div>

    <div class="mx-auto max-w-5xl px-4 md:px-6 py-6">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-steel-bright">
        <span class="flex items-center gap-2">
          <img src="<%= theme.author.avatar %>" alt="<%= theme.author.name %>" class="h-7 w-7 rounded-full border border-cyan/30">
          <%= page.author || theme.author.name %>
        </span>
        <span class="flex items-center gap-1.5 text-steel"><%- icon('calendar', 14) %> <%= date(page.date, 'MMMM DD, YYYY') %></span>
        <% if (page.updated && page.updated.valueOf() !== page.date.valueOf()) { %>
        <span class="flex items-center gap-1.5 text-steel"><%- icon('refresh-cw', 13) %> Updated <%= date(page.updated, 'MMMM DD, YYYY') %></span>
        <% } %>
        <span class="flex items-center gap-1.5 text-steel"><%- icon('clock', 14) %> <%= reading_time(page.content) %> min read</span>
      </div>

      <% if (tags.length) { %>
      <div class="mt-4 flex flex-wrap gap-2">
        <% tags.forEach(function (t) { %>
        <a href="<%- url_for('/tags/' + t.slug + '/') %>" class="inline-flex items-center gap-1 rounded-full border border-cyan/25 px-2.5 py-1 font-mono text-[10px] text-steel-bright hover:border-cyan hover:text-cyan transition-colors">
          <%- icon('hash', 9) %><%= t.name %>
        </a>
        <% }) %>
      </div>
      <% } %>

      <div class="mt-6 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 border border-cyan/20 font-mono text-[10px]">
        <% blueprintFields.forEach(function (f, i) { %>
        <div class="px-3 py-2 <%= i !== blueprintFields.length - 1 ? 'border-r border-cyan/15' : '' %> <%= i < 3 ? 'border-b sm:border-b-0 border-cyan/15' : '' %>">
          <div class="uppercase tracking-wider text-cyan-dim"><%= f.label %></div>
          <div class="mt-0.5 text-steel-bright truncate"><%= f.value %></div>
        </div>
        <% }) %>
      </div>
    </div>
  </header>

  <div class="mx-auto max-w-5xl px-4 md:px-6 py-4">
    <%- partial('_partial/breadcrumbs', { crumbs: [
      { label: 'Categories', path: '/categories/' },
      cat ? { label: cat.name, path: '/categories/' + cat.slug + '/' } : null,
      { label: page.title }
    ].filter(Boolean) }) %>
  </div>

  <div class="mx-auto max-w-6xl px-4 md:px-6 pb-16">
    <div class="grid grid-cols-1 xl:grid-cols-[1fr_240px] gap-10">
      <div class="min-w-0">
        <div class="bp-prose"><%- page.content %></div>

        <% if (page.prev || page.next) { %>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 my-12">
          <% if (page.prev) { %>
          <a href="<%- url_for(page.prev.path) %>" class="group border border-cyan/20 p-4 hover:border-cyan/50 transition-colors">
            <span class="flex items-center gap-1.5 bp-label mb-2"><%- icon('chevron-left', 12) %> Previous Document</span>
            <p class="font-display text-sm font-semibold text-white group-hover:text-cyan-bright transition-colors line-clamp-2"><%= page.prev.title %></p>
          </a>
          <% } else { %><div></div><% } %>
          <% if (page.next) { %>
          <a href="<%- url_for(page.next.path) %>" class="group border border-cyan/20 p-4 text-right hover:border-cyan/50 transition-colors">
            <span class="flex items-center justify-end gap-1.5 bp-label mb-2">Next Document <%- icon('chevron-right', 12) %></span>
            <p class="font-display text-sm font-semibold text-white group-hover:text-cyan-bright transition-colors line-clamp-2"><%= page.next.title %></p>
          </a>
          <% } else { %><div></div><% } %>
        </div>
        <% } %>

        <% if (relatedPosts.length) { %>
        <section class="my-12">
          <%- partial('_partial/section-marker', { index: '05', title: 'Related Documents', description: 'Other specifications filed under the same module.' }) %>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <% relatedPosts.forEach(function (post) { %>
            <%- partial('_partial/article-card', { post: post, variant: 'featured' }) %>
            <% }) %>
          </div>
        </section>
        <% } %>

        <% if (theme.comments.provider !== 'disabled') { %>
        <section class="my-12">
          <%- partial('_partial/section-marker', {
            index: '06',
            title: 'Field Notes & Comments',
            description: theme.comments.provider === 'giscus'
              ? 'Backed by GitHub Discussions — sign in with GitHub to leave a note.'
              : 'Session-local discussion — comments here are not persisted to a server in this build.'
          }) %>
          <div data-widget="Comments" data-widget-props='<%- widget_props({
            slug: page.slug,
            path: page.path,
            provider: theme.comments.provider,
            giscus: theme.comments.giscus
          }) %>'>
            <p class="text-xs text-steel-dim font-mono">Loading discussion module…</p>
          </div>
        </section>
        <% } %>
      </div>

      <aside id="bp-toc" class="sticky top-24 hidden max-h-[calc(100vh-7rem)] overflow-y-auto border border-cyan/15 bg-navy-700/30 p-4 xl:block"></aside>
    </div>
  </div>

  <!-- Mobile-only Table of Contents: a floating trigger + bottom-sheet drawer.
       Populated by the same enhancer that fills #bp-toc; hidden entirely
       (via JS) on posts with no headings. -->
  <button
    id="bp-toc-mobile-open"
    type="button"
    aria-label="Open table of contents"
    aria-expanded="false"
    class="hidden fixed bottom-5 right-5 z-40 flex h-12 w-12 items-center justify-center border border-cyan/40 bg-navy-700 text-cyan shadow-blueprint xl:hidden"
  >
    <%- icon('list', 18) %>
  </button>
  <div id="bp-toc-mobile-backdrop" class="hidden fixed inset-0 z-40 bg-ink/70 xl:hidden"></div>
  <div
    id="bp-toc-mobile-drawer"
    class="hidden fixed inset-x-0 bottom-0 z-50 max-h-[70vh] translate-y-full overflow-y-auto border-t border-cyan/25 bg-navy-600 p-4 pb-8 transition-transform duration-200 xl:hidden"
  >
    <div class="mb-3 flex items-center justify-between border-b border-cyan/15 pb-2">
      <span class="bp-label">On This Page</span>
      <button id="bp-toc-mobile-close" type="button" aria-label="Close table of contents" class="text-steel hover:text-cyan">
        <%- icon('x', 16) %>
      </button>
    </div>
    <div id="bp-toc-mobile-list"></div>
  </div>
</article>
